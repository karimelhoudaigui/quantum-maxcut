# Build applicatif rapide, utilisé uniquement par le BuildConfig OpenShift
# quantum-maxcut-frontend : BASE_IMAGE (build-arg, cf.
# openshift/quantum-frontend-buildconfig.yaml, dockerStrategy.buildArgs)
# pointe vers quantum-maxcut-frontend-base:latest (node_modules déjà
# installés, cf. Dockerfile.base) — on saute donc `npm ci`, l'essentiel du
# temps de build, pour la grosse majorité des commits qui ne touchent que le
# code de l'appli, pas les dépendances.
#
# ARG explicite plutôt que dockerStrategy.from (dans le YAML du
# BuildConfig) : dockerStrategy.from est censé remplacer automatiquement le
# FROM d'un Dockerfile, mais ne l'a pas fait de façon fiable en conditions
# réelles sur ce Dockerfile multi-stage — comportement OpenShift
# insuffisamment documenté pour ce cas précis. Un ARG est un mécanisme
# Docker standard, garanti, indépendant de la version d'OpenShift.
#
# ATTENTION : si package.json/package-lock.json changent, reconstruire
# d'abord quantum-maxcut-frontend-base (oc start-build
# quantum-maxcut-frontend-base) — sans quoi ce build utiliserait
# silencieusement des dépendances périmées (`npm run build` ne réinstalle
# rien ici). Le trigger ImageChange du BuildConfig relance automatiquement
# ce build-ci une fois la base reconstruite.
#
# Construit tel quel (BASE_IMAGE non fourni, donc node:20-alpine nu, sans
# node_modules), ce Dockerfile échoue : `npm run build` a besoin des
# dépendances déjà installées par Dockerfile.base. Pour un build local/CI
# autonome, utiliser Dockerfile (à la racine de app/), qui fait npm ci
# lui-même.
ARG BASE_IMAGE=node:20-alpine
FROM ${BASE_IMAGE} AS build

# cf. Dockerfile pour le détail de ces ARG (identique, non dupliqué ici).
ARG GIT_COMMIT=""
ARG GIT_COMMIT_DATE=""
ARG OPENSHIFT_BUILD_COMMIT=""

WORKDIR /app
COPY . .
RUN VITE_COMMIT_HASH="${GIT_COMMIT:-$OPENSHIFT_BUILD_COMMIT}" VITE_COMMIT_DATE="$GIT_COMMIT_DATE" \
    npm run build -- --base /

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
